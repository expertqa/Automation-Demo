{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "shared/**/*.ts",
    "reporter/**/*.ts",
    "ingest/**/*.ts",
    "database/**/*.ts",
    "artifacts/**/*.ts",
    "server/**/*.ts",
    "cli/**/*.ts",
    "fixtures/**/*.ts",
    "tests/**/*.ts",
    "drizzle.config.ts",
    "vitest.config.ts"
  ]
}
